NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=northwind
DB_USER=postgres
DB_PASSWORD=replace_me

# CORS: origen permitido. Usar coma para varios origenes. "*" solo para pruebas locales.
# CORS no reemplaza autenticacion: solo restringe navegadores.
CORS_ORIGIN=http://localhost:5173

# Limite del cuerpo JSON aceptado en POST
JSON_BODY_LIMIT=100kb

# Pool de conexiones
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# TLS hacia PostgreSQL. Con DB_SSL=true la verificacion de certificado queda ACTIVA.
# Si el servidor usa un CA propio, indicar la ruta del certificado en DB_SSL_CA.
DB_SSL=false
# DB_SSL_CA=C:\ruta\al\ca.crt
