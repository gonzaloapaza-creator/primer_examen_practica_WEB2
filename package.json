{
  "name": "northwind-orders-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de generacion de ordenes de venta sobre la base de datos Northwind (PostgreSQL) - Tecnologias Web II, UCB",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:check": "node scripts/check-db.js",
    "db:migrate": "node scripts/migrate.js",
    "test:db:setup": "cross-env NODE_ENV=test node scripts/setup-test-db.js",
    "test": "cross-env NODE_ENV=test node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:one": "cross-env NODE_ENV=test node --test --test-concurrency=1"
  },
  "overrides": {
    "qs": "^6.15.4"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "supertest": "^7.0.0"
  }
}
