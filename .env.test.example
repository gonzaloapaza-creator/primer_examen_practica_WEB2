# Copiar como .env.test. Se usa SOLO para las pruebas automatizadas.
# El nombre de la base DEBE terminar en _test: los scripts de prueba se niegan a
# trabajar contra cualquier otra base para no tocar la instalacion real.
NODE_ENV=test
PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_NAME=northwind_test
DB_USER=postgres
DB_PASSWORD=replace_me

CORS_ORIGIN=*
JSON_BODY_LIMIT=100kb
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=5000
DB_CONNECTION_TIMEOUT_MS=10000
DB_SSL=false

# Base de mantenimiento usada solo para ejecutar CREATE DATABASE
MAINTENANCE_DB=postgres
